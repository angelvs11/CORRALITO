# Copiar este archivo como .env y llenar los valores reales.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).

# Base de datos. Local: PostgreSQL de docker-compose (backend/docker-compose.yml).
# En AWS la URL real va en GitHub Secrets (DATABASE_URL), nunca en el codigo.
DATABASE_URL=postgresql+psycopg://oviapp:oviapp_local@localhost:5432/oviapp

# AWS
AWS_REGION=us-east-1
S3_BUCKET_FOTOS=

# Seguridad (cadena larga y aleatoria; cada quien genera la suya)
SECRET_KEY=
